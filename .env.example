# ============================================================
#  HR CORE — Variables de Entorno (Plantilla)
# ============================================================
#
#  📌 CÓMO USAR ESTE ARCHIVO:
#  1. Copia este archivo a `.env.local` (desarrollo local) y a `.env.production` (no, no — usa Vercel Dashboard).
#  2. En producción, configura estas mismas variables en:
#     Vercel → Project → Settings → Environment Variables
#  3. Marca cada variable con el entorno correcto:
#     - Production  (tu dominio público, ej. https://hrcore.app)
#     - Preview     (deploys de PRs, ej. https://hrcore-git-feature-username.vercel.app)
#     - Development (local, http://localhost:3000)
#  4. NUNCA commitees `.env.local` al repo (ya está en .gitignore).
#
#  Variables marcadas con 🔒 son SECRETAS — nunca las expongas al cliente.
#  Variables marcadas con 🌐 son públicas (NEXT_PUBLIC_*) — se incluyen en el bundle JS.
# ============================================================


# ============================================================
#  🌐 APLICACIÓN
# ============================================================

# URL pública del sitio en producción. La usan los emails de
# recuperación, los redirects de OAuth y los webhooks de Stripe.
NEXT_PUBLIC_SITE_URL=https://hrcore.app

# URL alternativa que algunas APIs internas usan (mismo valor que arriba).
NEXT_PUBLIC_APP_URL=https://hrcore.app

# Nombre comercial mostrado en el header, el dashboard y los PDFs.
NEXT_PUBLIC_APP_NAME=HR CORE

# Entorno: 'development' | 'preview' | 'production'
NODE_ENV=production


# ============================================================
#  🌐 SUPABASE (Base de Datos + Auth + Storage)
# ============================================================
#
#  Cómo obtenerlas:
#  1. Entra a https://app.supabase.com
#  2. Selecciona tu proyecto de HR CORE
#  3. Ve a Project Settings → API
#  4. Copia los valores exactos
#
#  ⚠️  Las claves "service_role" y "anon" son DISTINTAS.
#     - ANON KEY:   pública, se usa en el cliente con RLS activado.
#     - SERVICE KEY: privada 🔒, bypasea TODAS las RLS. Solo server-side.
#

# 🌐 Pública — Project URL (no es secreto, no se puede filtrar nada)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxx.supabase.co

# 🌐 Pública — Anon Key (protegida por RLS en BD)
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY_AQUI

# 🔒 SECRETA — Service Role Key (NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=TU_SUPABASE_SERVICE_ROLE_KEY_AQUI


# ============================================================
#  💳 STRIPE (Pagos)
# ============================================================
#
#  Cómo obtenerlas:
#  1. https://dashboard.stripe.com → Developers → API keys
#     - Publishable key → NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (público)
#     - Secret key      → STRIPE_SECRET_KEY (privado 🔒)
#  2. https://dashboard.stripe.com → Developers → Webhooks → Add endpoint
#     - URL: https://hrcore.app/api/webhooks/stripe
#     - Eventos: checkout.session.completed, payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
#     - Al crear el endpoint, Stripe te da el "Signing secret" → STRIPE_WEBHOOK_SECRET (privado 🔒)
#
#  💡 Si no configuras Stripe, el proyecto entra en MODO DEMO
#     (botones "Pagar" redirigen a un callback simulado).
#

# 🌐 Pública — publishable key (pk_test_... en modo test, pk_live_... en producción)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=TU_STRIPE_PUBLISHABLE_KEY_AQUI

#  🔒 SECRETA — secret key (sk_test_... en modo test, sk_live_... en producción)
STRIPE_SECRET_KEY=TU_STRIPE_SECRET_KEY_AQUI

# 🔒 SECRETA — signing secret del webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=TU_STRIPE_WEBHOOK_SECRET_AQUI

# (Opcional) ID de la cuenta de Stripe Connect si usas marketplace
# STRIPE_CONNECT_CLIENT_ID=ca_xxxxxxxxxxxxxxxxxxxxxxxx


# ============================================================
#  📧 EMAIL TRANSACCIONAL (Resend / SendGrid / SMTP)
# ============================================================
#
#  HR CORE envía emails transaccionales para:
#  - Recuperación de contraseña
#  - Confirmación de pago / factura
#  - Magic Link al candidato
#  - Notificación al reclutador
#
#  RECOMENDADO: Resend (gratis hasta 3,000 emails/mes, API simple).
#  Cómo obtenerla:
#    1. https://resend.com → Sign up
#    2. API Keys → Create API Key
#    3. Copia la key (re_xxx) → RESEND_API_KEY
#    4. Verifica tu dominio → FROM_EMAIL
#
#  Alternativa: SendGrid
#    SENDGRID_API_KEY=SG.xxxxx
#
#  Alternativa: SMTP genérico (Nodemailer)
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_USER=tu@gmail.com
#    SMTP_PASS=tu-app-password
#

#  🔒 SECRETA — API key del proveedor de email
RESEND_API_KEY=TU_RESEND_API_KEY_AQUI

# 🌐 Pública — dirección "from" para los emails (debe pasar SPF/DKIM)
FROM_EMAIL=hola@tu-dominio.com

# (Opcional) Email de soporte mostrado en el pie de los emails
SUPPORT_EMAIL=soporte@tu-dominio.com


# ============================================================
#  🔐 AUTENTICACIÓN (Opcional — para features avanzadas)
# ============================================================
#
#  Si usas Auth0, NextAuth, Clerk, etc. descomenta lo que necesites.
#  HR CORE actualmente usa Supabase Auth, así que no requiere esto.
#

# AUTH_SECRET=TU_AUTH_SECRET_AQUI
# NEXTAUTH_URL=https://tu-dominio.com
# NEXTAUTH_SECRET=TU_NEXTAUTH_SECRET_AQUI


# ============================================================
#  📊 ANALYTICS (Opcional)
# ============================================================

# Plausible (recomendado — sin cookies, GDPR-friendly)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tu-dominio.com

# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry (error tracking)
# SENTRY_DSN=TU_SENTRY_DSN_AQUI
# SENTRY_AUTH_TOKEN=TU_SENTRY_TOKEN_AQUI
# SENTRY_ORG=tu-org
# SENTRY_PROJECT=hr-core


# ============================================================
#  🛠️ OTROS
# ============================================================

# (Opcional) Token de Cloudflare Turnstile para anti-bot en /registro
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=TU_TURNSTILE_SITE_KEY
# TURNSTILE_SECRET_KEY=TU_TURNSTILE_SECRET_KEY

# (Opcional) Twilio para SMS del candidato (token de acceso por SMS)
# TWILIO_ACCOUNT_SID=TU_TWILIO_SID
# TWILIO_AUTH_TOKEN=TU_TWILIO_TOKEN
# TWILIO_PHONE_NUMBER=+525512345678

# (Opcional) Redis para rate limiting
# REDIS_URL=TU_REDIS_URL_AQUI
